# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=onioneye
POSTGRES_PASSWORD=changeme_in_production   # generate: openssl rand -base64 32
POSTGRES_DB=onioneye

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production      # generate: openssl rand -base64 32

# ── Tor Sidecar ────────────────────────────────────────────────────────────────
TOR_CONTROL_PASSWORD=changeme_in_production # generate: openssl rand -base64 24

# ── Nginx Basic Auth (analyst portal) ─────────────────────────────────────────
# Protects the frontend SPA and all API endpoints behind HTTP Basic Auth.
NGINX_AUTH_USER=analyst
NGINX_AUTH_PASS=changeme_in_production     # generate: openssl rand -base64 18

# ── Dashboard API ──────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_ALLOWED_ORIGIN=http://localhost  # restrict CORS to this origin

# ── Ingestion API ──────────────────────────────────────────────────────────────
INGESTION_PORT=8080
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
SESSION_WINDOW_SECONDS=900
OLLAMA_URL=http://ollama:11434
EXPANDER_MODEL=qwen2.5:3b
GUARD_MODEL=llama-guard3:1b
MAX_SEED_TERMS=10
MAX_DEPTH_DEFAULT=3
MAX_DEPTH_MAX=5

# ── Content Shield ─────────────────────────────────────────────────────────────
CSAM_HASH_SET_PATH=/data/hashes/csam_hashes.sha256

# ── Crawler Worker ─────────────────────────────────────────────────────────────
DASHBOARD_API_URL=http://dashboard-api:3000
DASHBOARD_NOTIFY_PATH=/api/v1/dashboard/notify
DASHBOARD_NOTIFY_TIMEOUT=3s

# ── Render Sandbox (screenshot pipeline) ─────────────────────────────────────
# The render-sandbox air-gapped Chromium renderer. URL is the internal compose
# hostname; token is required (empty = fail-closed, all renders rejected).
RENDER_SANDBOX_URL=http://render-sandbox:8084
RENDER_SANDBOX_TOKEN=changeme_in_production    # generate: openssl rand -base64 32

# ── Crawler Worker HTTP surface (dashboard-api → worker proxy) ────────────────
# Token for the worker's /screenshot endpoint, set from the same shared secret.
CRAWLER_WORKER_TOKEN=changeme_in_production     # generate: openssl rand -base64 32

# Bounded on-demand screenshot concurrency (Tor SOCKS + PNG buffer headroom).
MAX_CONCURRENT_SCREENSHOTS=4

# Worker anomaly kill/remake tuning (all optional, sane defaults shown).
ANOMALY_FAST_IDLE_TURNS=3
ANOMALY_FAST_TURN_DUR=1s
ANOMALY_MAX_FAIL_TURNS=3
ANOMALY_BACKOFF=15s
ANOMALY_MAX_PER_MINUTE=5